<Window x:Class="RescueWhale.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rescue Whale" Icon="icon.ico" Width="1200" Height="700" MinWidth="1120" MinHeight="690"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Cascadia Mono, Cascadia Code, Consolas, Courier New"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Grid x:Name="Root" Background="{DynamicResource Bg}">
        <Grid Margin="22,14,22,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- header: whale, name, link status -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Logo" FontSize="9.5" FontWeight="Bold" LineHeight="10.5" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="26,0,0,0">
                    <TextBlock Text="R E S C U E   W H A L E" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                    <TextBlock Text="// mouse control terminal" Style="{StaticResource Hint}" FontSize="13" Margin="2,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="2" Background="Transparent" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="14,10" VerticalAlignment="Center" MinWidth="330"
                        Cursor="Hand" ToolTip="Click to copy these details" MouseLeftButtonUp="StatusBox_Click">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="LINK ...... " Foreground="{DynamicResource Muted}"/>
                            <TextBlock x:Name="StateText" Text="SCANNING" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="BATTERY ... " Foreground="{DynamicResource Muted}"/>
                            <TextBlock x:Name="BatteryText" Text="--"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="MODEL ..... " Foreground="{DynamicResource Muted}"/>
                            <TextBlock x:Name="ModelText" Text="--"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="DEVICE ID . " Foreground="{DynamicResource Muted}"/>
                            <TextBlock x:Name="IdText" Text="--"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="FIRMWARE .. " Foreground="{DynamicResource Muted}"/>
                            <TextBlock x:Name="FirmwareText" Text="--"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- every setting, on one panel -->
            <Grid x:Name="Pages" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="ColLeft">
                    <HeaderedContentControl Style="{StaticResource Box}" Header="[ DPI STAGES ]"
                                            Tag="&gt; click a stage to make it active and edit it. the dpi button on the mouse steps through your stages.&#10;&gt; type a value and press enter, drag the bar, or use a preset. 50 to 26,000 in steps of 50, then steps of 100 up to 42,000.&#10;&gt; most players settle between 400 and 1,600. fewer stages means fewer accidental switches, so delete the ones you don't use.&#10;&gt; led sets the color tied to the selected stage.">
                        <StackPanel>
                            <UniformGrid x:Name="Stages" Rows="1" Margin="-3,0"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="RemoveStage" Grid.Column="3" Style="{StaticResource Ghost}" Content="DEL STAGE" Margin="14,0,0,0" Click="RemoveStage_Click"/>
                                <TextBlock Text="DPI &gt; " Style="{StaticResource Label}" Foreground="{DynamicResource Muted}"/>
                                <TextBox x:Name="DpiBox" Grid.Column="1" Width="74" KeyDown="DpiBox_KeyDown" LostFocus="DpiBox_LostFocus"/>
                                <Slider x:Name="DpiSlider" Grid.Column="2" Minimum="0" Maximum="1000" Margin="14,0,0,0" VerticalAlignment="Center" ValueChanged="DpiSlider_ValueChanged"/>
                            </Grid>
                            <DockPanel Margin="0,10,0,0">
                                <TextBlock Text="SET " Style="{StaticResource Label}" Foreground="{DynamicResource Muted}"/>
                                <StackPanel x:Name="Presets" Orientation="Horizontal"/>
                                <TextBlock Text="  LED " Style="{StaticResource Label}" Foreground="{DynamicResource Muted}"/>
                                <StackPanel x:Name="Swatches" Orientation="Horizontal" VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl Style="{StaticResource Box}" Header="[ POLLING RATE ]"
                                            Tag="&gt; how many times per second the mouse reports its position.&#10;&gt; 1k is plenty for most games and easiest on the battery.&#10;&gt; 2k to 8k can feel smoother on high-refresh monitors, but use more battery and cpu.">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="HZ" Width="150" Style="{StaticResource Label}"/>
                                <StackPanel x:Name="RateSeg" Orientation="Horizontal"/>
                            </DockPanel>
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl Style="{StaticResource Box}" Header="[ POWER ]"
                                            Tag="&gt; sleep after: how long the mouse sits still before it sleeps. shorter saves battery. it wakes on a move or a click.&#10;&gt; click response: the debounce time. lower is faster. if single clicks start registering twice, raise it one step at a time.">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="SLEEP AFTER" Width="150" Style="{StaticResource Label}"/>
                                <StackPanel x:Name="SleepSeg" Orientation="Horizontal"/>
                            </DockPanel>
                            <DockPanel Margin="0,12,0,0">
                                <TextBlock Text="CLICK RESPONSE" Width="150" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="DebounceText" DockPanel.Dock="Right" Width="52" TextAlignment="Right" Style="{StaticResource Label}" Foreground="{DynamicResource Accent}"/>
                                <Slider x:Name="DebounceSlider" Minimum="0" Maximum="30" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" ValueChanged="DebounceSlider_ValueChanged"/>
                            </DockPanel>
                        </StackPanel>
                    </HeaderedContentControl>

                    <!-- lives on the wireless receiver, not the mouse, so it works even while the mouse is asleep or on its cable -->
                    <HeaderedContentControl x:Name="RxBox" Style="{StaticResource Box}" Header="[ RECEIVER LED ]" Visibility="Collapsed"
                                            Tag="&gt; the light on the wireless receiver. this is stored on the receiver, so it works while the mouse is asleep or on its cable.&#10;&gt; polling: a color for the current polling rate. 125 red, 250 blue, 500 light green, 1k yellow, 2k purple, 4k green, 8k light blue.&#10;&gt; battery: a color for the mouse's battery level.&#10;&gt; low batt only: stays dark until the battery runs low.&#10;&gt; the colors themselves are built into the receiver and can't be changed.">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="SHOWS" Width="150" Style="{StaticResource Label}"/>
                                <StackPanel x:Name="RxSeg" Orientation="Horizontal"/>
                            </DockPanel>
                        </StackPanel>
                    </HeaderedContentControl>
                </StackPanel>

                <StackPanel x:Name="ColRight" Grid.Column="2">
                    <HeaderedContentControl Style="{StaticResource Box}" Header="[ BUTTONS ]"
                                            Tag="&gt; pick what each button does. one button always has to stay left click.&#10;&gt; dpi: next stage loops through your dpi stages. polling rate: next steps through the polling rates.&#10;&gt; combos, media keys, rapid-fire and macros set in the manufacturer's software show as custom and are left untouched.">
                        <StackPanel>
                            <StackPanel x:Name="KeyRows"/>
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl Style="{StaticResource Box}" Header="[ SENSOR ]"
                                            Tag="&gt; lift-off: how high you can lift the mouse before it stops tracking. lower suits players who lift and reposition a lot.&#10;&gt; sensor mode: applies at 1k and below. above that, or on the cable, the sensor always runs at full performance.&#10;&gt; motion sync: lines sensor readings up with each report for more even tracking, at a tiny latency cost.&#10;&gt; angle snap: straightens nearly-straight movements. handy for drawing lines, usually off for games.&#10;&gt; ripple control: smooths out jitter at very high dpi.">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="LIFT-OFF" Width="150" Style="{StaticResource Label}"/>
                                <StackPanel x:Name="LodSeg" Orientation="Horizontal"/>
                            </DockPanel>
                            <DockPanel Margin="0,9,0,0">
                                <TextBlock Text="SENSOR MODE" Width="150" Style="{StaticResource Label}"/>
                                <StackPanel x:Name="ModeSeg" Orientation="Horizontal"/>
                            </DockPanel>
                            <DockPanel Margin="0,9,0,0">
                                <TextBlock Text="MOTION SYNC" Width="150" Style="{StaticResource Label}"/>
                                <CheckBox x:Name="SwMotion" Style="{StaticResource Switch}" HorizontalAlignment="Left" Click="Switch_Click"/>
                            </DockPanel>
                            <DockPanel Margin="0,9,0,0">
                                <TextBlock Text="ANGLE SNAP" Width="150" Style="{StaticResource Label}"/>
                                <CheckBox x:Name="SwAngle" Style="{StaticResource Switch}" HorizontalAlignment="Left" Click="Switch_Click"/>
                            </DockPanel>
                            <DockPanel Margin="0,9,0,0">
                                <TextBlock Text="RIPPLE CONTROL" Width="150" Style="{StaticResource Label}"/>
                                <CheckBox x:Name="SwRipple" Style="{StaticResource Switch}" HorizontalAlignment="Left" Click="Switch_Click"/>
                            </DockPanel>
                        </StackPanel>
                    </HeaderedContentControl>
                </StackPanel>
            </Grid>

            <!-- shown when there is no mouse to talk to -->
            <Border x:Name="Offline" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,70,0,0"
                    Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Warn}" BorderThickness="1" Padding="30,22" MaxWidth="520">
                <StackPanel>
                    <TextBlock x:Name="OfflineTitle" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Warn}" TextAlignment="Center"/>
                    <TextBlock x:Name="OfflineBody" Style="{StaticResource Hint}" FontSize="13" Foreground="{DynamicResource Text}" TextAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <DockPanel Grid.Row="2" Margin="0,4,0,0">
                <ComboBox x:Name="ThemeBox" DockPanel.Dock="Right" Width="150" Height="24" SelectionChanged="ThemeBox_SelectionChanged"/>
                <TextBlock DockPanel.Dock="Right" Text="THEME " Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Text="&gt; changes save to the mouse as you make them_"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
