<Window x:Class="RescueWhale.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rescue Whale" Icon="icon.ico" Width="1200" Height="700" MinWidth="1120" MinHeight="690"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Cascadia Mono, Cascadia Code, Consolas, Courier New"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Grid x:Name="Root" Background="{StaticResource Bg}">
        <Grid Margin="22,14,22,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- header: whale, name, link status -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Logo" FontSize="10" FontWeight="Bold" LineHeight="11" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="26,0,0,0">
                    <TextBlock Text="R E S C U E   W H A L E" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                    <TextBlock Text="// mouse control terminal" Style="{StaticResource Hint}" FontSize="13" Margin="2,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="2" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14,10" VerticalAlignment="Center" MinWidth="330">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="LINK ...... " Foreground="{StaticResource Muted}"/>
                            <TextBlock x:Name="StateText" Text="SCANNING" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="BATTERY ... " Foreground="{StaticResource Muted}"/>
                            <TextBlock x:Name="BatteryText" Text="--"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="MODEL ..... " Foreground="{StaticResource Muted}"/>
                            <TextBlock x:Name="ModelText" Text="--"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="FIRMWARE .. " Foreground="{StaticResource Muted}"/>
                            <TextBlock x:Name="FirmwareText" Text="--"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- every setting, on one panel -->
            <Grid x:Name="Pages" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <HeaderedContentControl Style="{StaticResource Box}" Header="[ DPI STAGES ]">
                        <StackPanel>
                            <UniformGrid x:Name="Stages" Rows="1" Margin="-3,0"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="RemoveStage" Grid.Column="3" Style="{StaticResource Ghost}" Content="DEL STAGE" Margin="14,0,0,0" Click="RemoveStage_Click"/>
                                <TextBlock Text="DPI &gt; " Style="{StaticResource Label}" Foreground="{StaticResource Muted}"/>
                                <TextBox x:Name="DpiBox" Grid.Column="1" Width="74" KeyDown="DpiBox_KeyDown" LostFocus="DpiBox_LostFocus"/>
                                <Slider x:Name="DpiSlider" Grid.Column="2" Minimum="0" Maximum="1000" Margin="14,0,0,0" VerticalAlignment="Center" ValueChanged="DpiSlider_ValueChanged"/>
                            </Grid>
                            <DockPanel Margin="0,10,0,0">
                                <TextBlock Text="SET " Style="{StaticResource Label}" Foreground="{StaticResource Muted}"/>
                                <StackPanel x:Name="Presets" Orientation="Horizontal"/>
                                <TextBlock Text="  LED " Style="{StaticResource Label}" Foreground="{StaticResource Muted}"/>
                                <StackPanel x:Name="Swatches" Orientation="Horizontal" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" Text="click a stage to make it active and edit it. the dpi button on the mouse steps through them."/>
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl Style="{StaticResource Box}" Header="[ POLLING RATE ]">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="HZ" Width="150" Style="{StaticResource Label}"/>
                                <StackPanel x:Name="RateSeg" Orientation="Horizontal"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" Text="reports per second. higher is smoother but costs battery and cpu."/>
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl Style="{StaticResource Box}" Header="[ POWER ]">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="SLEEP AFTER" Width="150" Style="{StaticResource Label}"/>
                                <StackPanel x:Name="SleepSeg" Orientation="Horizontal"/>
                            </DockPanel>
                            <DockPanel Margin="0,12,0,0">
                                <TextBlock Text="CLICK RESPONSE" Width="150" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="DebounceText" DockPanel.Dock="Right" Width="52" TextAlignment="Right" Style="{StaticResource Label}" Foreground="{StaticResource Accent}"/>
                                <Slider x:Name="DebounceSlider" Minimum="0" Maximum="30" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" ValueChanged="DebounceSlider_ValueChanged"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" Text="lower click response is faster. if single clicks start doubling, raise it."/>
                        </StackPanel>
                    </HeaderedContentControl>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <HeaderedContentControl Style="{StaticResource Box}" Header="[ BUTTONS ]">
                        <StackPanel>
                            <StackPanel x:Name="KeyRows"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" Text="combos, media keys, rapid-fire and macros show as CUSTOM and are left untouched."/>
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl Style="{StaticResource Box}" Header="[ SENSOR ]">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="LIFT-OFF" Width="150" Style="{StaticResource Label}"/>
                                <StackPanel x:Name="LodSeg" Orientation="Horizontal"/>
                            </DockPanel>
                            <DockPanel Margin="0,9,0,0">
                                <TextBlock Text="SENSOR MODE" Width="150" Style="{StaticResource Label}"/>
                                <StackPanel x:Name="ModeSeg" Orientation="Horizontal"/>
                            </DockPanel>
                            <DockPanel Margin="0,9,0,0">
                                <TextBlock Text="MOTION SYNC" Width="150" Style="{StaticResource Label}"/>
                                <CheckBox x:Name="SwMotion" Style="{StaticResource Switch}" HorizontalAlignment="Left" Click="Switch_Click"/>
                                <TextBlock Text="  even tracking, tiny latency cost" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Margin="0,9,0,0">
                                <TextBlock Text="ANGLE SNAP" Width="150" Style="{StaticResource Label}"/>
                                <CheckBox x:Name="SwAngle" Style="{StaticResource Switch}" HorizontalAlignment="Left" Click="Switch_Click"/>
                                <TextBlock Text="  straightens near-straight moves" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Margin="0,9,0,0">
                                <TextBlock Text="RIPPLE CONTROL" Width="150" Style="{StaticResource Label}"/>
                                <CheckBox x:Name="SwRipple" Style="{StaticResource Switch}" HorizontalAlignment="Left" Click="Switch_Click"/>
                                <TextBlock Text="  smooths jitter at very high dpi" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                    </HeaderedContentControl>
                </StackPanel>
            </Grid>

            <!-- shown when there is no mouse to talk to -->
            <Border x:Name="Offline" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource Bg}" BorderBrush="{StaticResource Warn}" BorderThickness="1" Padding="30,22" MaxWidth="520">
                <StackPanel>
                    <TextBlock x:Name="OfflineTitle" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Warn}" TextAlignment="Center"/>
                    <TextBlock x:Name="OfflineBody" Style="{StaticResource Hint}" FontSize="13" Foreground="{StaticResource Text}" TextAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText" Grid.Row="2" Foreground="{StaticResource Muted}" Text="&gt; changes save to the mouse as you make them_"/>
        </Grid>
    </Grid>
</Window>
